# Copy this to .env and fill in your values
# DO NOT commit .env to git!

# Required: Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Get from https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Generated after running setup_youtube_auth.py
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Optional settings
DEFAULT_PRIVACY_STATUS=public
MAX_VIDEO_SIZE_MB=450
PORT=8000

# ── Auto-Scheduler Settings ───────────────────────────────────────────
# Enable/disable automatic scheduled uploads
SCHEDULER_ENABLED=true

# Hours between uploads (default 2 = 3 uploads/day)
SCHEDULER_INTERVAL_HOURS=2

# Max uploads per day (hard cap)
SCHEDULER_MAX_PER_DAY=3

# Timezone for upload scheduling (default UTC)
SCHEDULER_TIMEZONE=UTC

# Pipe-separated list of video source URLs to auto-upload from
# Example: https://www.instagram.com/reel/ABC123|https://www.instagram.com/reel/DEF456
SCHEDULER_SOURCES=https://www.instagram.com/reel/example1|https://www.instagram.com/reel/example2
