# ============================================
# YouTube Auto-Uploader — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# ---- Google Gemini AI (for SEO generation) ----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- YouTube OAuth 2.0 Credentials ----
# Create at: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Desktop or Web Application)
# 2. Enable the YouTube Data API v3 in your project
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# ---- YouTube OAuth Refresh Token ----
# Generated on first login; stored here for headless cloud use.
# Leave blank on first run — the app will guide you through auth.
YOUTUBE_REFRESH_TOKEN=

# ---- App Settings ----
# "public" (default, anyone can process) or "unlisted" or "private"
DEFAULT_PRIVACY_STATUS=public

# Maximum video file size in MB (free tier disk is ~512 MB)
MAX_VIDEO_SIZE_MB=450

# Port for the web server
PORT=8000

# Secret key for session security (generate a random string)
APP_SECRET_KEY=change-me-to-a-random-string